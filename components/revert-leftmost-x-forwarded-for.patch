             } else if let Ok(socket_addr) = part.parse::<SocketAddr>() {
-                return Some(socket_addr.ip());
-            }
+                socket_addr.ip()
+            } else {
+                continue;
+            };
+            forwarded_ips.push(ip);
         }
     }

-    None
